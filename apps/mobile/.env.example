# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* values reach the app, and they
# are readable by anyone who has the app — never put a secret here.

# Privy app id (the same one the API uses) and, if your Privy app has one, the
# mobile client id from the dashboard.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Where the API runs. On a physical phone this must be your computer's LAN
# address, e.g. http://192.168.1.20:8787 — localhost is the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Real money or test money: mainnet | testnet. Anything else means testnet.
# Must match BLOCKY_NETWORK in the API's .env.
EXPO_PUBLIC_NETWORK=testnet

# ERC-4337 bundler for the home chain. Optional: defaults to Pimlico's public
# endpoint for whichever network is set above. Use a keyed URL from
# dashboard.pimlico.io for real traffic. The app refuses to start if a Pimlico
# URL here is for the other network's chain (5042 mainnet, 5042002 testnet).
EXPO_PUBLIC_BUNDLER_URL=

# Passkey relying party (a domain you own, configured in Privy with the app
# association files). Leave empty to offer email login only.
EXPO_PUBLIC_PASSKEY_RP=
