# API configuration. Copy to .env and fill in. Never commit .env.
# (The mobile app has its own: apps/mobile/.env.example.)

NODE_ENV=development
PORT=8787

# Privy — https://dashboard.privy.io
# Enable email login and Ethereum embedded wallets. The secret stays server-side.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Anthropic — https://console.anthropic.com (required for the agent chat route)
ANTHROPIC_API_KEY=

# Real money or test money: mainnet | testnet. Anything else means testnet.
# Must match EXPO_PUBLIC_NETWORK in apps/mobile/.env — the app refuses to sign
# a plan built for the other network.
BLOCKY_NETWORK=testnet

# --- Testnet ---------------------------------------------------------------

# Arc testnet, the home chain on testnet. Optional: defaults to Circle's public
# endpoint, which is rate-limited but fine for development.
ARC_TESTNET_RPC_URL=

# Ethereum mainnet — ENS lookups only, we never transact here. Optional:
# without it, ENS names don't resolve and the agent asks for an address.
ETHEREUM_RPC_URL=

# Base Sepolia. Optional; only for multichain work.
BASE_SEPOLIA_RPC_URL=

# --- Mainnet ---------------------------------------------------------------
# All optional: each falls back to the chain's public endpoint, which is
# rate-limited. Replace with provider URLs (Alchemy, QuickNode…) as traffic grows.

ARC_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
UNICHAIN_RPC_URL=
AVALANCHE_RPC_URL=
HYPEREVM_RPC_URL=
ROBINHOOD_RPC_URL=

# Blockscout API key (free: https://dev.blockscout.com), for the activity feed
# on mainnet. Without it the feed shows only sends made through Blocky.
BLOCKSCOUT_API_KEY=

# Postgres. Optional in development: without it the API runs embedded Postgres
# (PGlite) persisted to .data/ at the repo root. Required in production.
DATABASE_URL=

# Blocky's fee on swaps and moves out of Arc, paid to this address in the same
# transaction as the move. Leave blank for no fee. Plain sends and moves home
# are always free. BLOCKY_FEE_BPS is basis points: 50 = 0.5%, at most 100.
BLOCKY_FEE_RECIPIENT=
BLOCKY_FEE_BPS=50
