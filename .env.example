# API configuration. Copy to .env and fill in. Never commit .env.
# (The mobile app has its own: apps/mobile/.env.example.)

NODE_ENV=development
PORT=8787

# Privy — https://dashboard.privy.io
# Enable email login and Ethereum embedded wallets. The secret stays server-side.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Anthropic — https://console.anthropic.com (required for the agent chat route)
ANTHROPIC_API_KEY=

# Arc testnet, the home chain. Optional: defaults to Circle's public endpoint,
# which is rate-limited but fine for development.
ARC_TESTNET_RPC_URL=

# Ethereum mainnet — ENS lookups only, we never transact here. Optional:
# without it, ENS names don't resolve and the agent asks for an address.
ETHEREUM_RPC_URL=

# Base Sepolia. Optional; only for multichain work.
BASE_SEPOLIA_RPC_URL=

# Postgres. Optional in development: without it the API runs embedded Postgres
# (PGlite) persisted to .data/ at the repo root. Required in production.
DATABASE_URL=
