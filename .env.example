# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8787

# Privy — https://dashboard.privy.io
# Create an app, enable passkey + email login, and enable embedded wallets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Anthropic — https://console.anthropic.com  (not needed until M2)
ANTHROPIC_API_KEY=

# RPC — https://dashboard.alchemy.com (Base Sepolia app)
BASE_SEPOLIA_RPC_URL=

# ZeroDev — https://dashboard.zerodev.app (bundler + paymaster, Base Sepolia)
ZERODEV_PROJECT_ID=
